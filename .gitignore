# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/

# uv
# (uv.lock IS committed — it pins the reproducible env)

# Artifacts / caches
*.pkl
*.parquet
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Documentation site build output (published by CI, never committed)
site/
.cache/

# Credentials / local config — never commit
.env
*.json.key
service-account*.json
application_default_credentials.json

# Terraform local state (remote GCS backend is authoritative)
*.tfstate
*.tfstate.*
.terraform/
.terraform-tmp/
.terraform.lock.hcl
# Never commit real ids (billing/org) or generated plans
terraform.tfvars
*.auto.tfvars
*.tfplan

# Throwaway spikes — live-infra experiments, never product surface
spikes/

# Notebooks
.ipynb_checkpoints/

# NeuralProphet / PyTorch-Lightning training artifacts (written to CWD on fit)
lightning_logs/

# Local-only working files — never tracked. CLAUDE.md stays on disk so it auto-loads for
# AI/dev contributors; NOTES.md is a scratch build log.
CLAUDE.md
NOTES.md

# OS / editor
.DS_Store
.idea/
.vscode/

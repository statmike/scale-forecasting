{
  "run_name": "naive_demo",
  "python_runtime": "spark",
  "spark_method": "naive",
  "data": {
    "source_table": "source_series",
    "horizon": 28,
    "series_limit": 100
  },
  "models": ["theta", "holtwinters", "sarimax", "xgboost"],
  "features": {
    "holidays": ["US"],
    "transform": "log1p"
  },
  "compute": {
    "persist_models": true
  }
}

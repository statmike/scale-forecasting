{
  "run_name": "ray_gpu_demo",
  "python_runtime": "ray",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 6
  },
  "models": ["neuralprophet", "theta", "arima_plus", "timesfm"],
  "features": {
    "holidays": ["US"]
  },
  "backtest": {
    "enabled": true,
    "n_folds": 2,
    "horizon": 28,
    "step": 28
  },
  "compute": {
    "use_gpu": true,
    "gpu_type": "T4",
    "gpu_fraction": "auto",
    "accelerator_count": 1,
    "ray_regions": ["us-central1", "us-east1", "us-west1"]
  }
}

{
  "run_name": "smoke_14_full_dag",
  "python_runtime": "spark",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 100
  },
  "models": [
    "theta",
    "holtwinters",
    "xgboost",
    "neuralprophet",
    "arima_plus",
    "timesfm"
  ],
  "features": {
    "holidays": ["US"],
    "transform": "log1p"
  },
  "backtest": {
    "enabled": true,
    "n_folds": 2,
    "horizon": 28,
    "step": 28
  },
  "ensemble": {
    "enabled": true,
    "strategies": ["mean", "median", "inverse_error", "nnls"]
  },
  "compute": {
    "families": {
      "deep_learning": {
        "hardware": "gpu",
        "gpu_type": "L4"
      }
    },
    "ensemble": {
      "mode": "barrier"
    }
  }
}

{
  "run_name": "smoke_36_covariate_fallback_multi_runtime",
  "python_runtime": "spark",
  "data": {
    "source_table": "source_series_covariates_iceberg",
    "horizon": 28,
    "series_limit": 24
  },
  "models": [
    "theta",
    "sarimax",
    "xgboost",
    "catboost",
    "tide",
    "patchtst",
    "arima_plus",
    "timesfm"
  ],
  "model_params": {
    "tide": {
      "training_mode": "global",
      "max_steps": 20,
      "input_size": 28
    },
    "patchtst": {
      "training_mode": "global",
      "max_steps": 20,
      "input_size": 28
    }
  },
  "hpo": {
    "enabled": true,
    "granularity": "fleetwide",
    "n_trials": 2,
    "sample_size": 10
  },
  "backtest": {
    "enabled": true,
    "horizon": 28,
    "n_folds": 2,
    "step": 28,
    "decision_metric": "rmsse"
  },
  "features": {
    "static_covariates": [
      "region",
      "category"
    ],
    "future_covariates": [
      "is_holiday",
      "promo_flag",
      "price_index"
    ],
    "past_covariates": [
      "temperature"
    ],
    "exog_lags": {
      "promo_flag": [1, 7],
      "temperature": [7, 14]
    },
    "on_unsupported_covariates": "fallback"
  },
  "ensemble": {
    "enabled": true,
    "strategies": [
      "mean",
      "inverse_error",
      "nnls"
    ]
  },
  "compute": {
    "use_gpu": false,
    "families": {
      "deep_learning": {
        "runtime": "ray",
        "hardware": "cpu"
      }
    },
    "ray_regions": [
      "us-central1",
      "us-east1",
      "us-west1"
    ],
    "ensemble": {
      "mode": "barrier"
    }
  }
}

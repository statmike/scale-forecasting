{
  "run_name": "smoke_16_cluster_split_hardware",
  "python_runtime": "spark",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 100
  },
  "models": ["theta", "holtwinters", "neuralprophet"],
  "features": {
    "holidays": ["US"],
    "transform": "log1p"
  },
  "compute": {
    "families": {
      "statistical": {
        "spark_mode": "cluster"
      },
      "deep_learning": {
        "spark_mode": "cluster",
        "hardware": "gpu",
        "gpu_type": "T4"
      }
    }
  }
}

{
  "run_name": "smoke_09_shared_ray",
  "python_runtime": "ray",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 100
  },
  "models": ["theta", "xgboost", "neuralprophet"],
  "features": {
    "holidays": ["US"],
    "transform": "log1p"
  },
  "compute": {
    "families": {
      "deep_learning": {
        "hardware": "gpu",
        "gpu_type": "T4"
      }
    },
    "ray_regions": ["us-central1", "us-east1", "us-west1"],
    "ray_autoscale": false
  }
}

{
  "run_name": "smoke_27_hpo_per_series",
  "python_runtime": "spark",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 50
  },
  "models": [
    "theta",
    "holtwinters",
    "naive_moving_average"
  ],
  "backtest": {
    "enabled": true,
    "horizon": 28,
    "n_folds": 2,
    "step": 28,
    "min_train": 1300,
    "decision_metric": "rmse"
  },
  "hpo": {
    "enabled": true,
    "engine": "optuna",
    "granularity": "per_series",
    "n_trials": 12
  }
}

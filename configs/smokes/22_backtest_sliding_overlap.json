{
  "run_name": "smoke_22_backtest_sliding_overlap",
  "python_runtime": "spark",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 20
  },
  "models": [
    "theta",
    "holtwinters",
    "naive_seasonal"

{
  "run_name": "smoke_38_vertex_custom_job",
  "python_runtime": "vertex",
  "data": {
    "source_table": "source_series_covariates_iceberg",
    "horizon": 28,
    "series_limit": 20
  },
  "models": [
    "theta",
    "sarimax",
    "xgboost",
    "lightgbm",
    "tide",
    "tsmixer",
    "neuralprophet"
  ],
  "model_params": {
    "tide": {
      "training_mode": "global",
      "max_steps": 20,
      "input_size": 28
    },
    "tsmixer": {
      "training_mode": "global",
      "max_steps": 20,
      "input_size": 28
    },
    "neuralprophet": {
      "training_mode": "hybrid",
      "epochs": 8
    }
  },
  "backtest": {
    "enabled": true,
    "horizon": 28,
    "n_folds": 1,
    "step": 28,
    "decision_metric": "rmsse"
  },
  "features": {
    "static_covariates": [
      "region",
      "category"
    ],
    "future_covariates": [
      "is_holiday",
      "promo_flag",
      "price_index"
    ],
    "past_covariates": [
      "temperature"
    ],
    "on_unsupported_covariates": "fallback"
  },
  "hierarchy": {
    "enabled": true,
    "levels": [
      [
        "region"
      ],
      [
        "region",
        "category"
      ]
    ],
    "reconciliation_methods": [
      "bottom_up",
      "wls_struct",
      "mint_shrink"
    ]
  },
  "ensemble": {
    "enabled": true,
    "strategies": [
      "mean",
      "inverse_error",
      "nnls"
    ]
  },
  "compute": {
    "use_gpu": true,
    "gpu_type": "L4",
    "machine_type": "n2-standard-8",
    "workers": 2,
    "families": {
      "deep_learning": {
        "runtime": "vertex",
        "hardware": "gpu",
        "gpu_type": "L4",
        "machine_type": "g2-standard-8",
        "workers": 1
      }
    },
    "ray_regions": [
      "us-central1",
      "us-east1",
      "us-west1"
    ]
  }
}

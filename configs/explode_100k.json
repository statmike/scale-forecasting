{
  "run_name": "explode_100k",
  "python_runtime": "spark",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 100000
  },
  "models": ["theta", "holtwinters", "sarimax", "xgboost"],
  "features": {
    "holidays": ["US"],
    "transform": "log1p"
  },
  "compute": {
    "persist_models": false,
    "bucket_target_cells": 200
  }
}

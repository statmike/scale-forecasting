{
  "run_name": "all_families_10k_full",
  "python_runtime": "ray",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 10000
  },
  "models": [
    "theta",
    "holtwinters",
    "sarimax",
    "xgboost",
    "neuralprophet",
    "arima_plus",
    "timesfm"
  ],
  "features": {
    "holidays": ["US"],
    "transform": "log1p"
  },
  "backtest": {
    "enabled": true,
    "n_folds": 2,
    "horizon": 28,
    "step": 28
  },
  "compute": {
    "persist_models": true,
    "use_gpu": true,
    "gpu_type": "T4",
    "gpu_fraction": "auto",
    "accelerator_count": 1,
    "ray_head_machine_type": "n1-highmem-32",
    "ray_gpu_machine_type": "n1-standard-8",
    "ray_autoscale": true,
    "ray_cpu_min_nodes": 1,
    "ray_cpu_max_nodes": 20,
    "ray_gpu_min_nodes": 1,
    "ray_gpu_max_nodes": 12,
    "ray_regions": ["us-central1", "us-east1", "us-west1"]
  }
}

{
  "run_name": "ensemble_demo",
  "python_runtime": "spark",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 10
  },
  "models": ["theta", "arima_plus", "timesfm"],
  "features": {
    "holidays": ["US"]
  },
  "backtest": {
    "enabled": true,
    "n_folds": 2,
    "horizon": 28,
    "step": 28
  },
  "ensemble": {
    "enabled": true,
    "strategies": ["mean", "median", "inverse_error"]
  }
}

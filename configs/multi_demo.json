{
  "run_name": "multi_demo",
  "python_runtime": "spark",
  "spark_method": "multi",
  "data": {
    "source_table": "source_series_iceberg",
    "horizon": 28,
    "series_limit": 100
  },
  "models": ["theta", "holtwinters", "xgboost", "lightgbm"],
  "features": {
    "holidays": ["US"],
    "transform": "log1p"
  },
  "compute": {
    "persist_models": true
  }
}

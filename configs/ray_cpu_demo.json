{
  "run_name": "ray_cpu_demo",
  "python_runtime": "ray",
  "data": {
    "source_table": "source_series",
    "horizon": 28,
    "series_limit": 6
  },
  "models": ["theta", "holtwinters", "arima_plus", "arima_plus_xreg", "timesfm"],
  "features": {
    "holidays": ["US"],
    "exog": ["price_index"]
  },
  "backtest": {
    "enabled": true,
    "n_folds": 2,
    "horizon": 28,
    "step": 28
  },
  "compute": {
    "use_gpu": false,
    "ray_regions": ["us-central1", "us-east1", "us-west1"]
  }
}

# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (never commit ids).
#
#   cp terraform.tfvars.example terraform.tfvars   # then edit
#   terraform init -backend-config="bucket=statmike-scale-forecasting-tfstate"
#   terraform plan    # review
#   terraform apply

project_id      = "statmike-scale-forecasting"
billing_account = "XXXXXX-XXXXXX-XXXXXX"
region          = "us-central1"

budget_amount_usd = 200

# --- BYO toggles (defaults shown) ---
# enable_apis             = true
# create_service_accounts = true
# create_composer         = false   # keep off — provisions Airflow; the run DAG is not shipped yet
# build_image             = true    # build+push the runtime image on apply; false = you build it yourself
# dataset_id              = "scale_forecasting"

# --- example dataset (on by default) ---
# run_seed        = true     # materialize the shipped example dataset on first apply (~8.5 min,
#                            # ~$0.15); set false to skip it, or seed_num_series = 100 to smoke first.
# seed_num_series = 100000   # 100 for a quick/cheap smoke, 100000 for the full shipped dataset.
# seed_variant    = "both"   # seed source_series_iceberg + source_series_native (one generated panel).

# --- default-on smoke forecast (proves the platform forecasts on first apply) ---
# run_smoke       = true     # tolerant/non-blocking: fast Python models on Dataproc ∥ arima_plus in
#                            # BigQuery, one run_id. Needs run_seed (the data) — a forecast failure
#                            # NEVER fails the apply; see the smoke_batch_id / smoke_describe_hint outputs.

# --- Colab Enterprise runtime templates (on by default; free at rest) ---
# See docs/notebook_runtimes.md for which template each notebook uses.
# create_colab_templates  = true    # sf-main (py311/[ray]) + sf-spark-connect (py312/[spark]); false = none
# colab_attach_network    = true    # attach the custom VPC (greenfield has no `default` network);
#                                   # false only in a brownfield project with a usable `default` network

# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (never commit ids).
#
#   cp terraform.tfvars.example terraform.tfvars   # then edit
#   terraform init -backend-config="bucket=statmike-scale-forecasting-tfstate"
#   terraform plan    # review
#   terraform apply

project_id      = "statmike-scale-forecasting"
billing_account = "XXXXXX-XXXXXX-XXXXXX"
region          = "us-central1"

budget_amount_usd = 200

# --- BYO toggles (defaults shown) ---
# enable_apis             = true
# create_service_accounts = true
# create_composer         = false   # keep off until you want scheduled DAG runs (Phase 7)
# dataset_id              = "scale_forecasting"
